// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String     @id @default(uuid())
  username        String     @unique
  passwordHash    String
  status          UserStatus @default(ACTIVE)
  // AI recipe assistant access. Off for everyone until an admin enables it
  // per user in the admin panel.
  aiEnabled       Boolean    @default(false)
  // Language the assistant answers and writes recipes in unless it is told
  // otherwise. Taken from the browser at registration; English for everyone
  // who registered before this existed.
  aiLanguage      String     @default("en")
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())
  recipes         Recipe[]
  memberships     CollectionMembership[]
  passwordResets  PasswordResetLink[]
  addedToCollections RecipeCollection[] @relation("AddedBy")
  usedInvite      InviteLink? @relation("InviteUsedBy")
  shoppingItems   ShoppingListItem[]
  shoppingHistory ShoppingHistoryEntry[]
  sentTransfers     OwnershipTransfer[] @relation("TransferFrom")
  receivedTransfers OwnershipTransfer[] @relation("TransferTo")
  defaultCollection Collection? @relation("DefaultCollection")

  @@index([status])
}

model Recipe {
  id            String   @id @default(uuid())
  title         String
  sourceUrl     String?
  isFallback    Boolean  @default(false)
  // How this recipe got here — drives the badge on the recipe page and the
  // origin filter. Null on recipes captured before the field existed.
  origin        RecipeOrigin?
  ingredients   Json
  instructions  Json
  prepTime      Int?
  cookTime      Int?
  servings      Int?
  notes         String?
  // Public share permalink token; anyone with it can view the recipe unauthenticated.
  shareToken    String?  @unique
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id])
  coverImageId  String?  @unique
  coverImage    Image?   @relation("CoverImage", fields: [coverImageId], references: [id])
  images        Image[]  @relation("RecipeImages")
  tags          Tag[]
  collections   RecipeCollection[]
  shoppingItems ShoppingListItem[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([title])
}

model Tag {
  id      String   @id @default(uuid())
  name    String   @unique
  recipes Recipe[]

  @@index([name])
}

// A collection is either an ordinary one — recipes are put in it by hand, as
// RecipeCollection rows — or a user's own recipe book (isDefault). A book has
// no RecipeCollection rows at all: every recipe its owner owns is in it, worked
// out at read time, so anyone the book is shared with sees the owner's whole
// library as it grows. Exactly one book per user (defaultForUserId is unique),
// its name is derived from the owner's username on read, and it cannot be
// renamed, deleted or handed over — everyone else on it is a VIEWER.
model Collection {
  id              String              @id @default(uuid())
  name            String
  isDefault       Boolean             @default(false)
  defaultForUserId String?            @unique
  defaultForUser  User?               @relation("DefaultCollection", fields: [defaultForUserId], references: [id], onDelete: Cascade)
  members         CollectionMembership[]
  recipes         RecipeCollection[]
  pendingTransfer OwnershipTransfer?
  createdAt       DateTime            @default(now())
}

// At most one pending transfer per collection (collectionId is unique).
// Accepting swaps roles (fromUser -> EDITOR, toUser -> OWNER) and deletes
// this row; rejecting or cancelling just deletes it.
model OwnershipTransfer {
  id           String     @id @default(uuid())
  collectionId String     @unique
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  fromUserId   String
  fromUser     User       @relation("TransferFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId     String
  toUser       User       @relation("TransferTo", fields: [toUserId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
}

model CollectionMembership {
  id           String     @id @default(uuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  role         Role

  @@unique([collectionId, userId])
}

model RecipeCollection {
  id           String     @id @default(uuid())
  recipeId     String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  addedById    String
  addedBy      User       @relation("AddedBy", fields: [addedById], references: [id])

  @@unique([recipeId, collectionId])
}

model Image {
  id            String   @id @default(uuid())
  recipeId      String
  recipe        Recipe   @relation("RecipeImages", fields: [recipeId], references: [id], onDelete: Cascade)
  filePath      String
  isCover       Boolean  @default(false)
  order         Int      @default(0)
  coverOfRecipe Recipe?  @relation("CoverImage")

  @@index([recipeId, order])
}

model ShoppingListItem {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  amount      String   @default("")
  unit        String   @default("")
  // false = still to buy, true = in the "done" section awaiting Clear
  bought      Boolean  @default(false)
  // Source recipe; null for manually added items. recipeTitle is a snapshot
  // so grouping keeps working after the recipe is deleted (recipeId nulls out).
  recipeId    String?
  recipe      Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  recipeTitle String?
  createdAt   DateTime @default(now())

  @@index([userId])
}

model ShoppingHistoryEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Snapshot of the bought items at Clear time:
  // [{ name, amount, unit, recipeId?, recipeTitle? }]
  items     Json
  createdAt DateTime @default(now())

  @@index([userId])
}

model InviteLink {
  id          String    @id @default(uuid())
  token       String    @unique
  description String
  used        Boolean   @default(false)
  // Who registered with this link. Null on links used before this field
  // existed (or when that user was since deleted) — shown as "unknown".
  usedById    String?   @unique
  usedBy      User?     @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
}

model PasswordResetLink {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  used      Boolean   @default(false)
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  expiresAt DateTime

  @@index([userId])
}

// MANUAL        typed in from a blank recipe
// PARSED        a site parser (or the JSON-LD/fallback reader) captured it
// PARSED_EDITED parsed, then changed by hand before a save
// AI_PARSED     the assistant read the page
// AI_GENERATED  the assistant wrote it in a chat
enum RecipeOrigin {
  MANUAL
  PARSED
  PARSED_EDITED
  AI_PARSED
  AI_GENERATED
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

// ACTIVE -> PENDING_DELETION (admin marks; user is locked out immediately)
// PENDING_DELETION -> DELETED (cleanup worker has removed the user's content;
// the row survives only as an anonymized tombstone when shared content still
// references it, otherwise it is deleted outright)
enum UserStatus {
  ACTIVE
  PENDING_DELETION
  DELETED
}
