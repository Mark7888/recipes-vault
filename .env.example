# ============================================================
# RecipeVault — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ============================================================

# ── Database ────────────────────────────────────────────────
# Password for the PostgreSQL user (used by Docker Compose)
POSTGRES_PASSWORD=changeme_use_a_strong_password

# Full connection string (used by the app; for local dev outside Docker)
DATABASE_URL=postgresql://recipevault:changeme_use_a_strong_password@localhost:5432/recipevault

# ── JWT ─────────────────────────────────────────────────────
# Random secret, at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars

# ── Admin credentials (no database row — env-only) ──────────
# The admin exists only here. There is no admin user in the database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin1234!

# ── Application ─────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# Directory where uploaded recipe images are stored (inside the container)
IMAGES_DIR=/data/images

# ── Capture pipeline ─────────────────────────────────────────
# Timeout (ms) and max response size (bytes) when fetching recipe URLs
FETCH_TIMEOUT_MS=10000
FETCH_MAX_BYTES=10485760
