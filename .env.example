# ============================================================
# RecipeVault — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ============================================================

# ── Database ────────────────────────────────────────────────
# Password for the PostgreSQL user (used by Docker Compose)
POSTGRES_PASSWORD=changeme_use_a_strong_password

# Full connection string (used by the app; for local dev outside Docker)
DATABASE_URL=postgresql://recipevault:changeme_use_a_strong_password@localhost:5432/recipevault

# ── JWT ─────────────────────────────────────────────────────
# Random secret, at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars

# ── Admin credentials (no database row — env-only) ──────────
# The admin exists only here. There is no admin user in the database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin1234!

# ── Application ─────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# Directory where uploaded recipe images are stored (inside the container)
IMAGES_DIR=/data/images

# ── Capture pipeline ─────────────────────────────────────────
# Timeout (ms) and max response size (bytes) when fetching recipe URLs
FETCH_TIMEOUT_MS=10000
FETCH_MAX_BYTES=10485760

# ── AI recipe assistant (OpenRouter) ─────────────────────────
# Optional. Leave OPENROUTER_API_KEY empty to disable the assistant entirely —
# the chat option then disappears from the Add Recipe page.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any OpenRouter model slug. The model needs image input + structured output
# support. Swap this to change models — no code change needed.
OPENROUTER_MODEL=google/gemini-3.1-flash-lite

# Override only if you proxy OpenRouter or run a compatible gateway.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Max tokens the model may generate per reply, and how long to wait for it.
AI_MAX_OUTPUT_TOKENS=2048
AI_TIMEOUT_MS=60000

# Per-user cap on assistant requests per minute (protects your credits).
AI_RATE_LIMIT_PER_MINUTE=20

# How much of a page's text is handed to the model when a URL is parsed with AI.
# Bigger means bloated pages survive the cut; it also costs more per parse.
AI_PAGE_MAX_CHARS=24000

# Reported to OpenRouter as HTTP-Referer / X-Title (shows up in their dashboard).
AI_APP_URL=
AI_APP_NAME=RecipeVault

# ── Access control ───────────────────────────────────────────
# The assistant is OFF for every user by default. Turn it on per user in the
# admin panel (/admin → Users → Enable AI).
